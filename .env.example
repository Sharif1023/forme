# Copy to .env locally. Never commit .env or merchant credentials.
API_PORT=4000
API_HOST=127.0.0.1
NODE_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:4000
APP_URL=http://127.0.0.1:5174
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4000
MYSQL_HOST=127.0.0.1
# The bundled Windows runtime uses 3307; an external MySQL server normally uses 3306.
MYSQL_PORT=3307
MYSQL_DATABASE=forme
# Isolated integration tests only; create this database separately on an external server.
MYSQL_DATABASE_TEST=forme_test
MYSQL_USER=forme_app
MYSQL_PASSWORD=
# Generate independent secrets locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_HOURS=12
RESERVATION_MINUTES=60
UPLOAD_DIR=uploads
# Optional for new AI fitting images; alternatively save it in Admin > AI fitting room.
OPENAI_API_KEY=
# First-owner bootstrap only. Remove ADMIN_PASSWORD after bootstrap succeeds.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store owner
# Docker Compose database password, if using containers.
# MYSQL_ROOT_PASSWORD=
